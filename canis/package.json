{
  "name": "canis-operator-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "C.A.N.I.S. operator interface framework for the Agentverse 420-drum warehouse",
  "scripts": {
    "public-map": "node scripts/build-public-map.mjs",
    "predev": "npm run public-map && npm run brand",
    "dev": "vite",
    "prebuild": "npm run public-map && npm run brand",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "pretest": "npm run public-map && npm run brand",
    "test": "vitest run",
    "check:privacy": "node scripts/check-privacy.mjs",
    "e2e": "playwright test",
    "screenshots": "CANIS_SCREENSHOTS=1 playwright test screenshots",
    "check": "npm run typecheck && npm test && npm run build && npm run check:privacy && npm run e2e",
    "brand": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
