over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
)
{
    float exposure:fStop = 5
    float exposure:iso = 200
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
}

def Xform "World"
{
    def "Hall"
    {
        def "Materials"
        {
            def Material "PreviewFloor"
            {
                token outputs:surface.connect = </World/Hall/Materials/PreviewFloor/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.29, 0.31, 0.3)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.65
                    token outputs:surface
                }
            }

            def Material "PreviewWall"
            {
                token outputs:surface.connect = </World/Hall/Materials/PreviewWall/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.4, 0.43, 0.43)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }

            def Material "Drum_faded_yellow"
            {
                token outputs:surface.connect = </World/Hall/Materials/Drum_faded_yellow/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Hall/Materials/Drum_faded_yellow/diffuseColor.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Hall/Materials/Drum_faded_yellow/normal.outputs:rgb>
                    float inputs:roughness = 0.35
                    float inputs:roughness.connect = </World/Hall/Materials/Drum_faded_yellow/roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "TransformUV"
                {
                    uniform token info:id = "UsdTransform2d"
                    float2 inputs:in.connect = </World/Hall/Materials/Drum_faded_yellow/UV.outputs:result>
                    float2 inputs:scale = (1, 1)
                    float2 outputs:result
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/drum_faded_yellow_s42_v1_diffuseColor.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Hall/Materials/Drum_faded_yellow/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    color3f outputs:rgb
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/drum_faded_yellow_s42_v1_roughness.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/Drum_faded_yellow/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @assets/generated/drum_faded_yellow_s42_v1_normal.png@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/Drum_faded_yellow/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
            }

            def Material "Drum_faded_yellow_Lid"
            {
                token outputs:surface.connect = </World/Hall/Materials/Drum_faded_yellow_Lid/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Hall/Materials/Drum_faded_yellow_Lid/diffuseColor.outputs:rgb>
