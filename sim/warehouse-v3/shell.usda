#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Hall"
    {
        def "Materials"
        {
            def Material "V3Floor"
            {
                token outputs:surface.connect = </World/Hall/Materials/V3Floor/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 1, 1)
                    color3f inputs:diffuseColor.connect = </World/Hall/Materials/V3Floor/diffuseColor.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Hall/Materials/V3Floor/normal.outputs:rgb>
                    float inputs:roughness = 0.58
                    float inputs:roughness.connect = </World/Hall/Materials/V3Floor/roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "TransformUV"
                {
                    uniform token info:id = "UsdTransform2d"
                    float2 inputs:in.connect = </World/Hall/Materials/V3Floor/UV.outputs:result>
                    float2 inputs:scale = (1, 1)
                    float2 outputs:result
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/v3_floor_diffuse.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Hall/Materials/V3Floor/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    color3f outputs:rgb
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/v3_floor_roughness.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/V3Floor/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @assets/v3_floor_normal.png@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/V3Floor/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
