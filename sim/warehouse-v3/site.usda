#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

over "World" {
over "StorageMaterials" {
def Material "Frame" {
        token outputs:surface.connect = </World/StorageMaterials/Frame/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.12, 0.16, 0.18)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
def Material "Traffic" {
        token outputs:surface.connect = </World/StorageMaterials/Traffic/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.94, 0.62, 0.045)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
def Material "White" {
        token outputs:surface.connect = </World/StorageMaterials/White/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.84, 0.87, 0.85)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
def Material "Olive" {
        token outputs:surface.connect = </World/StorageMaterials/Olive/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.15, 0.24, 0.2)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
def Material "Plywood" {
        token outputs:surface.connect = </World/StorageMaterials/Plywood/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.41, 0.27, 0.14)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
def Material "Red" {
        token outputs:surface.connect = </World/StorageMaterials/Red/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.56, 0.08, 0.044)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
def Material "Blue" {
        token outputs:surface.connect = </World/StorageMaterials/Blue/Shader.outputs:surface>
        def Shader "Shader" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.075, 0.21, 0.35)
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
    }
}
def Xform "RobotSpawn" {
        double3 xformOp:translate = (1, 6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
over "Hall" {
def Scope "Markings" {
