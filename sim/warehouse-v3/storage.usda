        def Shader "Surface" {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </World/StorageMaterials/D339/Print.outputs:rgb>
            float inputs:roughness = 0.38
            float inputs:metallic = 0.22
            token outputs:surface
        }
        def Shader "Print" {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @assets/drums/D339.png@
            token inputs:sourceColorSpace = "sRGB"
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "clamp"
            float2 inputs:st.connect = </World/StorageMaterials/D339/UV.outputs:result>
            float3 outputs:rgb
        }
        def Shader "UV" {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
