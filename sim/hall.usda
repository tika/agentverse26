over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
)
{
    float exposure:fStop = 5
    float exposure:iso = 400
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
}

def Xform "World"
{
    def Xform "Hall"
    {
        def Scope "Materials"
        {
            def Material "Floor"
            {
                token outputs:surface.connect = </World/Hall/Materials/Floor/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                    color3f inputs:diffuseColor.connect = </World/Hall/Materials/Floor/diffuseColor.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Hall/Materials/Floor/normal.outputs:rgb>
                    float inputs:roughness = 0.6
                    float inputs:roughness.connect = </World/Hall/Materials/Floor/roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "TransformUV"
                {
                    uniform token info:id = "UsdTransform2d"
                    float2 inputs:in.connect = </World/Hall/Materials/Floor/UV.outputs:result>
                    float2 inputs:scale = (1, 1)
                    float2 outputs:result
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/floor_s42_v2_diffuseColor.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Hall/Materials/Floor/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    color3f outputs:rgb
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/floor_s42_v2_roughness.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/Floor/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @assets/generated/floor_s42_v2_normal.png@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/Floor/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
            }

            def Material "SideWall"
            {
                token outputs:surface.connect = </World/Hall/Materials/SideWall/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                    color3f inputs:diffuseColor.connect = </World/Hall/Materials/SideWall/diffuseColor.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Hall/Materials/SideWall/normal.outputs:rgb>
                    float inputs:roughness = 0.6
                    float inputs:roughness.connect = </World/Hall/Materials/SideWall/roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "TransformUV"
                {
                    uniform token info:id = "UsdTransform2d"
                    float2 inputs:in.connect = </World/Hall/Materials/SideWall/UV.outputs:result>
                    float2 inputs:scale = (4.1666665, 1)
                    float2 outputs:result
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/wall_s42_v2_diffuseColor.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Hall/Materials/SideWall/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    color3f outputs:rgb
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/wall_s42_v2_roughness.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/SideWall/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @assets/generated/wall_s42_v2_normal.png@
                    float4 inputs:scale = (2, 2, 2, 1)
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/SideWall/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    normal3f outputs:rgb
                }
            }

            def Material "EndWall"
            {
                token outputs:surface.connect = </World/Hall/Materials/EndWall/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                    color3f inputs:diffuseColor.connect = </World/Hall/Materials/EndWall/diffuseColor.outputs:rgb>
                    float inputs:metallic = 0
                    normal3f inputs:normal.connect = </World/Hall/Materials/EndWall/normal.outputs:rgb>
                    float inputs:roughness = 0.6
                    float inputs:roughness.connect = </World/Hall/Materials/EndWall/roughness.outputs:r>
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "TransformUV"
                {
                    uniform token info:id = "UsdTransform2d"
                    float2 inputs:in.connect = </World/Hall/Materials/EndWall/UV.outputs:result>
                    float2 inputs:scale = (2.7083333, 1)
                    float2 outputs:result
                }

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/wall_s42_v2_diffuseColor.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Hall/Materials/EndWall/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    color3f outputs:rgb
                }

                def Shader "roughness"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @assets/generated/wall_s42_v2_roughness.png@
                    token inputs:sourceColorSpace = "raw"
                    float2 inputs:st.connect = </World/Hall/Materials/EndWall/TransformUV.outputs:result>
                    token inputs:wrapS = "repeat"
                    token inputs:wrapT = "repeat"
                    float outputs:r
                }

                def Shader "normal"
                {
                    uniform token info:id = "UsdUVTexture"
                    float4 inputs:bias = (-1, -1, -1, 0)
                    asset inputs:file = @assets/generated/wall_s42_v2_normal.png@
